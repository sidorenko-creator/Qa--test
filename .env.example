# Environments
UI_BASE_URL=https://aqa-app.vercel.app
API_BASE_URL=https://jsonplaceholder.typicode.com

# Run options (all optional)
# HEADED=true      # show the browser window
# SLOW_MO=300      # slow every browser action down by N ms (for watching a test)
# WORKERS=4        # number of parallel workers (default: CI 2, local = half of CPU cores)
# KEEP_AUTH=true   # keep playwright/.auth after the run (for --no-deps re-runs)

# Адреса окружений
UI_BASE_URL=https://aqa-app.vercel.app
API_BASE_URL=https://jsonplaceholder.typicode.com

# Параметры запуска (все необязательные)
# HEADED=true      # показывать окно браузера
# SLOW_MO=300      # замедлить каждое действие браузера на N мс (чтобы видеть, что происходит)
# WORKERS=4        # число параллельных воркеров (по умолчанию: CI = 2, локально = половина ядер)
# KEEP_AUTH=true   # не удалять playwright/.auth после прогона (для повторных запусков с --no-deps)

{
  "name": "qa-playwright-tests",
  "version": "1.2.0",
  "description": "UI and API automation tests with Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium --project=api-tests --project=unit",
    "test:all": "playwright test",
    "test:headless": "playwright test --project=chromium --project=api-tests --project=unit",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:api": "playwright test --project=api-tests",
    "test:unit": "playwright test --project=unit",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "api",
    "e2e"
  ],
  "author": "Danylo Sydorenko",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^17.4.2"
  }
}

{
  "name": "qa-playwright-tests",
  "version": "1.0.0",
  "description": "UI and API automation tests with Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test --project=api-tests",
    "test:e2e": "playwright test --project=chromium",
    "report": "playwright show-report"
  },
  "keywords": ["qa", "automation", "playwright", "api", "e2e"],
  "author": "Danylo Sydorenko",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^17.4.2"
  }
}
